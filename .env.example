# ── Pick at least ONE LLM provider ───────────────────────────────────────────

# xAI Grok — free credits on signup, very capable
# Sign up: https://console.x.ai
XAI_API_KEY=your_xai_key_here

# GROQ — FREE, no credit card needed
# Sign up: https://console.groq.com
# Free tier: 14,400 requests/day, llama-3.3-70b is excellent
# GROQ_API_KEY=your_groq_key_here

# Google Gemini — FREE tier available
# Sign up: https://aistudio.google.com/app/apikey
# Free: 15 RPM, 1M tokens/day on Flash
# GEMINI_API_KEY=your_gemini_key_here

# Anthropic Claude — paid only (~$5 to start)
# ANTHROPIC_API_KEY=your_anthropic_key_here

# OpenAI GPT-4o — paid only
# OPENAI_API_KEY=your_openai_key_here

# ── Optional: Tavily web search for the Developer agent ───────────────────────
# FREE tier: 1,000 searches/month — https://app.tavily.com
# TAVILY_API_KEY=your_tavily_key_here

# ── Model overrides (optional) ────────────────────────────────────────────────
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-1.5-flash
